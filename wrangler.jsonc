{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-maker",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "invoice.solusikoding.com", "custom_domain": true }
  ]
}
